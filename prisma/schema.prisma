generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  EXECUTOR
  VIEWER
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RiskLevel {
  NORMAL
  ATTENTION
  RISK
  CRITICAL
}

enum StageStatus {
  NOT_STARTED
  IN_PROGRESS
  DONE
  BLOCKED
}

model User {
  id            String            @id @default(cuid())
  name          String
  email         String            @unique
  passwordHash  String
  ownedSpaces   Workspace[]       @relation("WorkspaceOwner")
  memberships   WorkspaceMember[]
  createdCards  Card[]            @relation("CardCreator")
  assignedCards Card[]            @relation("CardAssignee")
  snapshots     ProgressSnapshot[]
  comments      CardComment[]
  activities    CardActivityLog[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

model Workspace {
  id          String            @id @default(cuid())
  name        String
  description String?
  ownerId     String
  owner       User              @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members     WorkspaceMember[]
  boards      Board[]
  invitations Invitation[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())

  @@unique([workspaceId, userId])
}

model Board {
  id          String        @id @default(cuid())
  workspaceId String
  name        String
  description String?
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  columns     BoardColumn[]
  cards       Card[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model BoardColumn {
  id        String   @id @default(cuid())
  boardId   String
  name      String
  position  Int
  wipLimit  Int?
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards     Card[]
  outgoingTransitions BoardStageTransition[] @relation("TransitionSource")
  incomingTransitions BoardStageTransition[] @relation("TransitionTarget")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([boardId, position])
}

model Card {
  id                 String             @id @default(cuid())
  boardId            String
  columnId           String
  title              String
  description        String?
  creatorId          String
  assigneeId         String?
  priority           Priority           @default(MEDIUM)
  dueDate            DateTime?
  plannedStartDate   DateTime?
  plannedEndDate     DateTime?
  actualStartDate    DateTime?
  actualEndDate      DateTime?
  manualProgress     Int                @default(0)
  riskLevel          RiskLevel          @default(NORMAL)
  riskScore          Int                @default(0)
  stuckFlag          Boolean            @default(false)
  stuckReason        String?
  forecastEndDate    DateTime?
  board              Board              @relation(fields: [boardId], references: [id], onDelete: Cascade)
  column             BoardColumn        @relation(fields: [columnId], references: [id], onDelete: Restrict)
  creator            User               @relation("CardCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  assignee           User?              @relation("CardAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  stages             TaskStage[]
  snapshots          ProgressSnapshot[]
  comments           CardComment[]
  activities         CardActivityLog[]
  insights           TaskAiInsight[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model BoardStageTransition {
  id             String      @id @default(cuid())
  sourceColumnId String
  targetColumnId String
  sourceColumn   BoardColumn @relation("TransitionSource", fields: [sourceColumnId], references: [id], onDelete: Cascade)
  targetColumn   BoardColumn @relation("TransitionTarget", fields: [targetColumnId], references: [id], onDelete: Cascade)
  createdAt      DateTime    @default(now())

  @@unique([sourceColumnId, targetColumnId])
}

model TaskStage {
  id               String      @id @default(cuid())
  cardId           String
  name             String
  description      String?
  position         Int
  plannedStartDate DateTime?
  plannedEndDate   DateTime?
  actualStartDate  DateTime?
  actualEndDate    DateTime?
  plannedWeight    Int         @default(1)
  actualProgress   Int         @default(0)
  status           StageStatus @default(NOT_STARTED)
  isBlocking       Boolean     @default(false)
  card             Card        @relation(fields: [cardId], references: [id], onDelete: Cascade)
  insights         TaskAiInsight[]
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@unique([cardId, position])
}

model ProgressSnapshot {
  id             String   @id @default(cuid())
  cardId         String
  snapshotDate   DateTime
  plannedPercent Int
  actualPercent  Int
  source         String
  comment        String?
  createdById    String
  card           Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  createdBy      User     @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt      DateTime @default(now())
}

model CardComment {
  id        String   @id @default(cuid())
  cardId    String
  userId    String
  body      String
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CardActivityLog {
  id        String   @id @default(cuid())
  cardId    String
  userId    String
  action    String
  oldValue  String?
  newValue  String?
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
}

model TaskAiInsight {
  id                      String    @id @default(cuid())
  cardId                  String
  analysisDate            DateTime  @default(now())
  riskLevel               RiskLevel
  delayPercent            Int
  delayDays               Int
  stuckStageId            String?
  summary                 String
  issuesJson              String
  recommendationsJson     String
  predictedCompletionDate DateTime?
  confidence              Float     @default(0.75)
  card                    Card      @relation(fields: [cardId], references: [id], onDelete: Cascade)
  stuckStage              TaskStage? @relation(fields: [stuckStageId], references: [id], onDelete: SetNull)
  createdAt               DateTime  @default(now())
}

model Invitation {
  id          String        @id @default(cuid())
  workspaceId String
  email       String
  name        String?
  userId      String?
  role        WorkspaceRole @default(MEMBER)
  token       String        @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())
}
